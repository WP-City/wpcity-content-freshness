msgstr "Intervalle par défaut pour la relecture. Modifiable article par article."

#: includes/Admin/Settings_Page.php:157
msgid "Rate & Review"
msgstr "Noter et commenter"

#. translators: %s: five star rating link.
#: includes/Admin/Settings_Page.php:159
