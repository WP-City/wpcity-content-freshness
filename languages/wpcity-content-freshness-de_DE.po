msgstr "Probleme oder Fragen? Wir helfen dir gerne weiter!"

#: includes/Admin/Settings_Page.php:167
msgid "Get Support"
msgstr "Support erhalten"

#: includes/Admin/Settings_Page.php:171
msgid "About Content Freshness"
msgstr "Über Inhaltsaktualität"

#: includes/Admin/Settings_Page.php:173
msgid "Keep your content up to date by tracking when each page was last reviewed."
msgstr "Halte deine Inhalte aktuell, indem du festhältst, wann jede Seite zuletzt geprüft wurde."

#: includes/Admin/Settings_Page.php:175
msgid "Review interval per post or page"
msgstr "Prüfintervall pro Beitrag oder Seite"

