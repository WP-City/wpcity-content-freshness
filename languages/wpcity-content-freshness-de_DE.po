msgstr "Wähle aus, welche Inhaltstypen auf Aktualität geprüft werden."

#: includes/Admin/Settings_Page.php:136
msgid "Default Review Interval"
msgstr "Standard-Prüfintervall"

#: includes/Admin/Settings_Page.php:139
msgid "Default interval for reviewing content. Can be overridden per post."
msgstr "Standardintervall für die Prüfung von Inhalten. Pro Beitrag anpassbar."

#: includes/Admin/Settings_Page.php:157
msgid "Rate & Review"
msgstr "Bewerten & rezensieren"

#. translators: %s: five star rating link.
#: includes/Admin/Settings_Page.php:159
#, php-format
