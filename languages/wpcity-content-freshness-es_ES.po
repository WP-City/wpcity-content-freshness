msgstr "Intervalo predeterminado para revisar el contenido. Se puede cambiar en cada entrada."

#: includes/Admin/Settings_Page.php:157
msgid "Rate & Review"
msgstr "Valorar y reseñar"

#. translators: %s: five star rating link.
#: includes/Admin/Settings_Page.php:159
